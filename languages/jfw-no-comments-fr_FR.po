#. Description of the plugin
#: jfw-no-comments.php
msgid "Disables comments, pingbacks and trackbacks everywhere, and purges existing comments. Block editor notes keep working."
msgstr "Désactive les commentaires, pingbacks et trackbacks partout, et supprime les commentaires existants. Les notes de l’éditeur de blocs continuent de fonctionner."

#. Author of the plugin
#: jfw-no-comments.php
msgid "Julien Félix Web"
msgstr ""

#. Author URI of the plugin
#: jfw-no-comments.php
msgid "https://www.julienfelix.com/"
msgstr ""

#: includes/class-admin.php:82
#: includes/class-admin.php:83
#: includes/class-admin.php:97
msgid "Comments purge"
msgstr "Purge des commentaires"

#. translators: 1: number of deleted comments, 2: number of closed contents
#: includes/class-admin.php:105
#, php-format
msgid "%1$d comments deleted, %2$d contents closed to comments and pings."
msgstr "%1$d commentaires supprimés, %2$d contenus fermés aux commentaires et aux pings."

#: includes/class-admin.php:114
msgid "New comments, pingbacks and trackbacks are already blocked. This page deletes the existing ones and closes discussion on existing content. Block editor notes are kept."
msgstr "Les nouveaux commentaires, pingbacks et trackbacks sont déjà bloqués. Cette page supprime ceux qui existent et ferme la discussion sur les contenus existants. Les notes de l’éditeur de blocs sont conservées."

#: includes/class-admin.php:125
msgid "Comments to delete"
msgstr "Commentaires à supprimer"

#: includes/class-admin.php:129
msgid "Contents open to comments or pings"
msgstr "Contenus ouverts aux commentaires ou aux pings"

#: includes/class-admin.php:136
msgid "Delete all these comments for good?"
msgstr "Supprimer définitivement tous ces commentaires ?"

#: includes/class-admin.php:139
msgid "This cannot be undone: export the database first."
msgstr "Cette action est irréversible : exportez d’abord la base de données."

#: includes/class-admin.php:140
msgid "Delete comments and close discussion"
msgstr "Supprimer les commentaires et fermer la discussion"

#: includes/class-admin.php:143
msgid "Nothing to purge."
msgstr "Rien à purger."

#: includes/class-admin.php:154
msgid "Sorry, you are not allowed to do that."
msgstr "Désolé, vous n’avez pas l’autorisation de faire cela."

#: includes/class-blocker.php:122
#: includes/class-blocker.php:213
msgid "Comments are disabled on this site."
msgstr "Les commentaires sont désactivés sur ce site."

#: includes/class-blocker.php:123
msgid "Comments disabled"
msgstr "Commentaires désactivés"

#: includes/class-purge.php:176
msgid "Approved"
msgstr "Approuvés"

#: includes/class-purge.php:177
msgid "Pending"
msgstr "En attente"

#: includes/class-purge.php:178
msgid "Spam"
msgstr "Indésirables"

#: includes/class-purge.php:179
msgid "Trash"
msgstr "Corbeille"

#: includes/class-purge.php:180
msgid "On trashed content"
msgstr "Sur des contenus à la corbeille"
